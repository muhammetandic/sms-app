<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Only for the optional Drive backup; the app is fully usable without it
         because every sync path degrades to "not signed in". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Retained so the app qualifies for ROLE_SMS: the system role definition
         requires a WAP_PUSH_DELIVER receiver, and without this permission the
         platform can drop that broadcast. The app does not process MMS. -->
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Enables the vibration on the incoming-message channel; a normal
      permission, granted automatically at install time. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Declared but only enforced on API 33+, where it is a runtime permission.
      Below 33 the declaration is ignored and notifications are allowed by
      default. Without the declaration, `SmsPermissions` offers to request a
      permission the app does not hold, and the request fails silently.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Telephony is needed to send and receive, but the app degrades to
         read-only local history without it, so the feature is advertised
         rather than required. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
      API 30+ package visibility: the app fires implicit ACTION_VIEW intents for
      links inside message bodies. Without declaring the URI schemes here the
      platform blocks the query and openUri() silently finds no handler, so taps
      on phone numbers, web links, map coordinates and email addresses do nothing.
    -->
    <queries>
        <!-- tel: links → dialer -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <!-- http / https links → browser -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- geo: links → maps -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- mailto: links → email -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:name=".SmsApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmsApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SmsApp">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Compose an SMS: sms: / smsto: -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
            </intent-filter>

            <!-- Share text into the app from another app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- SMS_DELIVER is only delivered to the default SMS app. -->
        <receiver
            android:name=".sms.receive.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- The system's ROLE_SMS definition requires a WAP_PUSH_DELIVER
             receiver with the MMS MIME type, so this declaration is what keeps
             the app eligible to be the default SMS app. It deliberately does
             nothing: the app supports SMS only. -->
        <receiver
            android:name=".sms.receive.WapPushDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Per-part send results and delivery reports for outgoing messages. -->
        <receiver
            android:name=".sms.send.SmsSendResultReceiver"
            android:exported="false" />

        <!--
          The notification's action buttons. Not exported and not permission
          guarded: only this app's own notifications produce these intents, and
          they are explicit, so nothing else can trigger them.
        -->
        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <!-- Required to qualify for ROLE_SMS; handles "reply with message" from other apps. -->
        <service
            android:name=".sms.respond.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
            </intent-filter>
        </service>
    </application>
</manifest>