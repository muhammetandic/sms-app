    <string name="conversations_empty">No conversations yet</string>
    <string name="conversations_title">Messages</string>
    <string name="conversations_group_label">Group</string>
    <!-- The content description of the floating action button; the label is an
         icon, so without this the control is unlabelled for a screen reader. -->
    <string name="conversations_compose">New message</string>
    <!--
      A plural rather than "%d unread" because the noun carries the count in some
      languages. Turkish happens not to, but a format string that hardcodes the
      noun cannot be translated into one that does.
    -->
    <plurals name="conversation_unread_count">
        <item quantity="one">%1$d unread</item>
        <item quantity="other">%1$d unread</item>
    </plurals>
