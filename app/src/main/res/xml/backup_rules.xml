<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 counterpart of `data_extraction_rules.xml`. `allowBackup` is
  false so nothing is backed up either way; this states the same exclusion
  explicitly for API 30-31, where `fullBackupContent` is what the platform reads.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
